<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_controller</name>
  <version>1.1.0</version>
  <description>Reference solution for a beginner ROS 2 workshop: publishers, subscribers, services, launch files and a simple go-to-point controller using turtlesim</description>
  <maintainer email="a.plastropoulos.229@cranfield.ac.uk">Angelos</maintainer>
  <license>Apache-2.0</license>

  <!-- Libraries and message types used by the nodes -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlesim</depend>
  <depend>std_srvs</depend>

  <!-- Needed at run time by the launch file -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
